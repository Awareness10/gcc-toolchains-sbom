# SBOM validator. Kept separate so the validator never enters the toolchain build environment.
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
COPY validate-requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --root-user-action=ignore --disable-pip-version-check \
      --no-deps -r /tmp/requirements.lock
ENTRYPOINT ["pyspdxtools"]
