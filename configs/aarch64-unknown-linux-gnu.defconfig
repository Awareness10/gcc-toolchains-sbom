CT_ARCH_ARM=y
CT_ARCH_64=y
CT_CONFIG_VERSION="4"
CT_LOCAL_TARBALLS_DIR="/work/src"
CT_SAVE_TARBALLS=y
CT_VERIFY_DOWNLOAD_DIGEST=y
CT_VERIFY_DOWNLOAD_DIGEST_SHA512=y
CT_PREFIX_DIR="/work/build/x-tools/${CT_TARGET}"
CT_INSTALL_LICENSES=y
CT_LOG_FILE_COMPRESS=y
CT_TARGET_VENDOR="unknown"
CT_KERNEL_LINUX=y
CT_LINUX_V_6_1=y
CT_BINUTILS_V_2_43=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_V_2_36=y
CT_GCC_V_14=y
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_V_16=y
CT_GDB_CROSS=y
# CT_GDB_CROSS_PYTHON is not set
CT_GDB_GDBSERVER=y
CT_GMP_V_6_3=y
CT_MPFR_V_4_2=y
CT_MPC_V_1_3=y
CT_ISL_V_0_27=y
CT_ZLIB_V_1_3_1=y
CT_ZSTD_V_1_5_7=y
CT_NCURSES_V_6_5=y
CT_EXPAT_V_2_7=y
CT_LIBICONV_V_1_18=y
CT_GETTEXT_V_0_26=y
